{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.1.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "alarms",
    "contextMenus",
    "favicon"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdOpen__"
    },
    "quick-save": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdQuickSave__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
